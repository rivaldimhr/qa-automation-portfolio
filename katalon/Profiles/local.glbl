<?xml version="1.0" encoding="UTF-8"?>
<GlobalVariableEntities>
   <description>Server lokal, dipakai juga di CI: KINGSHANDs di port 8000, Restful-Booker di port 3001.</description>
   <name>local</name>
   <tag></tag>
   <defaultProfile>false</defaultProfile>
   <GlobalVariableEntity>
      <description>Alamat KINGSHANDs (python -m http.server 8000 dari folder web)</description>
      <initValue>'http://localhost:8000/'</initValue>
      <name>BASE_URL</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Alamat Restful-Booker (npm start)</description>
      <initValue>'http://localhost:3001'</initValue>
      <name>RB_URL</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Akun demo penanggung jawab</description>
      <initValue>'demo@kingshand.id'</initValue>
      <name>PJ_EMAIL</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Kata sandi demo penanggung jawab (publik, tertulis di halaman login)</description>
      <initValue>'demo123'</initValue>
      <name>PJ_PASSWORD</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Akun demo admin lembaga</description>
      <initValue>'admin@kingshand.id'</initValue>
      <name>ADMIN_EMAIL</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Kata sandi demo admin (publik, tertulis di halaman login)</description>
      <initValue>'admin123'</initValue>
      <name>ADMIN_PASSWORD</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>User Restful-Booker (didokumentasikan publik)</description>
      <initValue>'admin'</initValue>
      <name>RB_USER</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Kata sandi Restful-Booker (didokumentasikan publik)</description>
      <initValue>'password123'</initValue>
      <name>RB_PASSWORD</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Batas tunggu elemen (detik)</description>
      <initValue>10</initValue>
      <name>TIMEOUT</name>
   </GlobalVariableEntity>
</GlobalVariableEntities>
