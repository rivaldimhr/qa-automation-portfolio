              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tidak memberi token', () => pm.expect(pm.response.json()).to.not.have.property('token'));",
                  "pm.test('Alasan: Bad credentials', () => pm.expect(pm.response.json().reason).to.eql('Bad credentials'));",
                  "// BUG-09: seharusnya 401 Unauthorized",
                  "pm.test('Status saat ini 200 (lihat BUG-09)', () => pm.response.to.have.status(200));"
                ]
              }
            }
