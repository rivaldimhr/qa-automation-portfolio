              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Dinda\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": 275,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
