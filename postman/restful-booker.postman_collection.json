    "name": "Restful-Booker: smoke & negative",
    "description": "Smoke test dan negative test untuk Restful-Booker. Jalankan berurutan (Collection Runner atau Newman): request berikutnya memakai token dan bookingid dari request sebelumnya.\n\nBug yang masih terbuka diberi nama [BUG-xx] dan diuji terhadap perilaku saat ini, dengan catatan perilaku yang seharusnya.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Respons di bawah 2 detik', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Smoke",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.test('Token 15 karakter heksadesimal', () => pm.expect(token).to.match(/^[0-9a-f]{15}$/));",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buat booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('firstname', 'Rivaldi');",
                  "pm.collectionVariables.set('lastname', 'QA-' + Math.random().toString(16).slice(2, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Ada bookingid', () => pm.expect(body.bookingid).to.be.a('number'));",
                  "pm.test('Data tersimpan sesuai yang dikirim', () => {",
                  "  pm.expect(body.booking.lastname).to.eql(pm.collectionVariables.get('lastname'));",
                  "  pm.expect(body.booking.totalprice).to.eql(150);",
                  "  pm.expect(body.booking.bookingdates).to.eql({checkin: '2026-12-01', checkout: '2026-12-05'});",
                  "});",
                  "pm.test('Skema respons', () => pm.response.to.have.jsonSchema({",
                  "  type: 'object', required: ['bookingid', 'booking'],",
                  "  properties: {bookingid: {type: 'integer'}, booking: {type: 'object',",
                  "    required: ['firstname', 'lastname', 'totalprice', 'depositpaid', 'bookingdates'],",
                  "    properties: {totalprice: {type: 'integer'}, depositpaid: {type: 'boolean'}}}}",
                  "}));",
                  "pm.collectionVariables.set('bookingId', body.bookingid);"
                ]
              }
            }
          ]
        },
        {
          "name": "Baca booking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
